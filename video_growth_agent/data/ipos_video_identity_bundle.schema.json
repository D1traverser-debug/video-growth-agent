{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ip-studio-os:video-identity-bundle:1.0",
  "title": "IP Studio OS Video Identity Bundle",
  "description": "Portable, versioned, owner-approved character canon export from IP Studio OS to downstream video production systems.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "issuer",
    "bundle_id",
    "project_id",
    "issued_at",
    "canon",
    "approval",
    "readiness",
    "usage",
    "assets",
    "continuity",
    "source_provenance_refs"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "issuer": {
      "const": "IP_STUDIO_OS"
    },
    "bundle_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "bundle_uri": {
      "type": "string"
    },
    "canon": {
      "type": "object",
      "required": [
        "canon_id",
        "version",
        "carrier",
        "identity_thesis",
        "identity_invariants",
        "allowed_variations",
        "forbidden_drift"
      ],
      "properties": {
        "canon_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "carrier": {
          "type": "string",
          "minLength": 1
        },
        "identity_thesis": {
          "type": "string",
          "minLength": 1
        },
        "identity_invariants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allowed_variations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forbidden_drift": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": true
    },
    "approval": {
      "type": "object",
      "required": [
        "status",
        "approval_ref",
        "approved_at"
      ],
      "properties": {
        "status": {
          "enum": [
            "OWNER_APPROVED",
            "NOT_APPROVED",
            "REVOKED",
            "SUPERSEDED"
          ]
        },
        "approval_ref": {
          "type": "string"
        },
        "approved_at": {
          "type": "string"
        },
        "approved_by": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "readiness": {
      "type": "object",
      "required": [
        "status",
        "gates"
      ],
      "properties": {
        "status": {
          "enum": [
            "READY_FOR_VIDEO",
            "NOT_READY",
            "REVOKED",
            "SUPERSEDED"
          ]
        },
        "gates": {
          "type": "object",
          "required": [
            "G2",
            "G7",
            "G8"
          ],
          "properties": {
            "G2": {
              "type": "string"
            },
            "G7": {
              "type": "string"
            },
            "G8": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "usage": {
      "type": "object",
      "required": [
        "video_allowed",
        "usage_constraints"
      ],
      "properties": {
        "video_allowed": {
          "type": "boolean"
        },
        "usage_constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "asset_id",
          "version_id",
          "kind",
          "role",
          "uri",
          "digest",
          "state",
          "approved_for_video",
          "rights_ref",
          "provenance_refs"
        ],
        "properties": {
          "asset_id": {
            "type": "string",
            "minLength": 1
          },
          "version_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "uri": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-fA-F]{64}$"
          },
          "state": {
            "enum": [
              "PROMOTED",
              "CANDIDATE",
              "REJECTED",
              "RETIRED",
              "STALE"
            ]
          },
          "approved_for_video": {
            "type": "boolean"
          },
          "rights_ref": {
            "type": "string"
          },
          "consent_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "requires_consent": {
            "type": "boolean"
          },
          "provenance_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "continuity": {
      "type": "object",
      "required": [
        "dimensions",
        "rules"
      ],
      "properties": {
        "dimensions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "dimension",
              "severity",
              "mode"
            ],
            "properties": {
              "dimension": {
                "type": "string",
                "minLength": 1
              },
              "severity": {
                "enum": [
                  "HARD",
                  "SOFT"
                ]
              },
              "mode": {
                "enum": [
                  "PRESERVE",
                  "EXPECT",
                  "ALLOW_CHANGE"
                ]
              },
              "expected_value": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reason": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "source_provenance_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
