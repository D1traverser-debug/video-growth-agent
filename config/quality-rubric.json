{
  "version": "0.3.0",
  "scale": {
    "1": "broken_or_placeholder",
    "2": "template_or_demo_quality",
    "3": "competent_but_visibly_below_reference",
    "4": "publishable_and_close_to_reference_with_only_minor_gaps",
    "5": "reference_level_or_better"
  },
  "deferred_pass_phrases": [
    "后续",
    "后面再",
    "正式阶段",
    "正式资产阶段",
    "继续强化",
    "可通过",
    "可以再",
    "之后再",
    "later",
    "will improve",
    "can be improved",
    "in the final",
    "formal build"
  ],
  "stages": {
    "LOOKDEV": {
      "target_artifact": "hero_frames",
      "min_benchmarks": 3,
      "blind_review_required": true,
      "require_target_digest": true,
      "forbid_deferred_pass": true,
      "required_evidence_min": 2,
      "roles": {
        "creative_director": {
          "dimensions": ["benchmark_parity", "distinctiveness", "hero_frame_strength", "advertiser_showcase"],
          "min_each": 4.0,
          "min_average": 4.25
        },
        "art_director": {
          "dimensions": ["composition_hierarchy", "material_light_depth", "typography", "design_system_coherence"],
          "min_each": 4.0,
          "min_average": 4.0
        }
      }
    },
    "VISUAL_PREVIEW": {
      "target_artifact": "visual_preview",
      "min_benchmarks": 3,
      "blind_review_required": true,
      "require_target_digest": true,
      "forbid_deferred_pass": true,
      "required_evidence_min": 2,
      "roles": {
        "creative_director": {
          "dimensions": ["benchmark_parity", "distinctiveness", "advertiser_showcase", "overall_craft"],
          "min_each": 4.0,
          "min_average": 4.25
        },
        "art_director": {
          "dimensions": ["composition_hierarchy", "material_light_depth", "typography", "visual_consistency"],
          "min_each": 4.0,
          "min_average": 4.0
        },
        "motion_director": {
          "dimensions": ["motion_craft", "easing_stagger", "camera_depth", "motion_explains"],
          "min_each": 4.0,
          "min_average": 4.0
        },
        "director": {
          "dimensions": ["narrative_visual_arc", "shot_scale_contrast", "reveal_payoff", "emotion_rhythm"],
          "min_each": 4.0,
          "min_average": 4.0
        },
        "retention_editor": {
          "dimensions": ["first_2s_stop", "visual_reset_frequency", "silent_comprehension", "dead_zone_risk"],
          "min_each": 4.0,
          "min_average": 4.0
        }
      }
    },
    "ROUGH_CUT": {
      "target_artifact": "rough_cut",
      "min_benchmarks": 3,
      "blind_review_required": true,
      "require_target_digest": true,
      "forbid_deferred_pass": true,
      "required_evidence_min": 2,
      "roles": {
        "creative_director": {
          "dimensions": ["benchmark_parity", "overall_craft", "cohesion", "advertiser_showcase"],
          "min_each": 4.0,
          "min_average": 4.25
        },
        "director": {
          "dimensions": ["narrative_arc", "pace_contrast", "shot_progression", "payoff"],
          "min_each": 4.0,
          "min_average": 4.0
        },
        "editor": {
          "dimensions": ["pace", "compression", "cut_quality", "redundancy_control"],
          "min_each": 4.0,
          "min_average": 4.0
        },
        "retention_editor": {
          "dimensions": ["first_2s_stop", "midpoint_retention", "dead_zone_risk", "ending_strength"],
          "min_each": 4.0,
          "min_average": 4.0
        }
      }
    }
  }
}
