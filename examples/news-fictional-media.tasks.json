[
  {
    "task_id": "fact-research",
    "title": "Verify the event, primary records, attributed reporting and unknown allegations",
    "kind": "news_research",
    "executor": "agent",
    "depends_on": [],
    "inputs": [],
    "outputs": [
      "fact-map"
    ],
    "requirements": {
      "source_priority": [
        "primary",
        "direct documents",
        "reputable reporting"
      ],
      "claim_classification": [
        "PRIMARY_CONFIRMED",
        "ATTRIBUTED_REPORT",
        "ALLEGATION_UNVERIFIED",
        "UNKNOWN"
      ],
      "source_freshness_required": true
    },
    "acceptance": {
      "facts": "Every material claim has an exact source, date, attribution and confidence; allegations are never promoted to facts."
    },
    "priority": 100
  },
  {
    "task_id": "media-inspection",
    "title": "Inspect the exact supplied clip and bind every visual claim to observed frames",
    "kind": "media_inspection",
    "executor": "agent",
    "depends_on": [],
    "inputs": [
      "source-video"
    ],
    "outputs": [
      "visual-evidence-map"
    ],
    "requirements": {
      "exact_bytes_required": true,
      "frame_timestamps_required": true,
      "no_unseen_content_claims": true
    },
    "acceptance": {
      "inspection": "The map identifies actual scenes, timing, visual subjects and uncertainty from the exact source digest."
    },
    "priority": 100
  },
  {
    "task_id": "rights-and-identity",
    "title": "Resolve clip ownership, likeness, provenance and permitted uses",
    "kind": "rights_review",
    "executor": "human",
    "depends_on": [],
    "inputs": [
      "source-video"
    ],
    "outputs": [
      "rights-status"
    ],
    "requirements": {
      "rights_status_required": true,
      "likeness_consent_required": true,
      "source_and_usage_scope_required": true
    },
    "acceptance": {
      "rights": "Rights, identity/likeness and usage scope are evidenced; UNKNOWN blocks downstream release."
    },
    "priority": 100
  },
  {
    "task_id": "editorial-angle-candidates",
    "title": "Develop distinct event-led editorial angles before visual dependency is resolved",
    "kind": "creative_research",
    "executor": "agent",
    "depends_on": [
      "fact-research"
    ],
    "inputs": [
      "fact-map"
    ],
    "outputs": [
      "angle-candidates"
    ],
    "requirements": {
      "minimum_distinct_angles": 7,
      "each_angle_has_distinct_humor_mechanism_and_speaker": true,
      "news_language_primary_satire_target": true
    },
    "acceptance": {
      "angles": "Candidates reveal an event-specific contradiction; they do not paraphrase the supplied clip or force keywords."
    },
    "priority": 90
  },
  {
    "task_id": "visual-semantic-bridge",
    "title": "Test how the observed clip adds a second meaning to the news without plot recap",
    "kind": "editorial_visual_analysis",
    "executor": "agent",
    "depends_on": [
      "fact-research",
      "media-inspection"
    ],
    "inputs": [
      "fact-map",
      "visual-evidence-map"
    ],
    "outputs": [
      "visual-semantic-bridge"
    ],
    "requirements": {
      "mutual_relevance_required": true,
      "fiction_not_evidence": true
    },
    "acceptance": {
      "bridge": "The visual meaning is grounded in inspected frames and adds a distinct semantic layer to the verified event."
    },
    "priority": 90
  },
  {
    "task_id": "editorial-selection",
    "title": "Select the editorial thesis only after fact, visual and rights constraints are reconciled",
    "kind": "editorial_decision",
    "executor": "agent",
    "depends_on": [
      "editorial-angle-candidates",
      "visual-semantic-bridge",
      "rights-and-identity"
    ],
    "inputs": [
      "fact-map",
      "angle-candidates",
      "visual-evidence-map",
      "visual-semantic-bridge",
      "rights-status"
    ],
    "outputs": [
      "editorial-reading"
    ],
    "requirements": {
      "decision_receipt_required": true,
      "seven_platforms_need_distinct_signatures": true
    },
    "acceptance": {
      "selection": "The chosen thesis preserves factual/fictional separation and the rights status is explicit."
    },
    "priority": 100
  },
  {
    "task_id": "editorial-plan",
    "title": "Convert the approved editorial thesis into a versioned claim-beat-shot plan",
    "kind": "editorial_planning",
    "executor": "agent",
    "depends_on": [
      "editorial-selection"
    ],
    "inputs": [
      "fact-map",
      "visual-evidence-map",
      "editorial-reading"
    ],
    "outputs": [
      "editorial-plan"
    ],
    "requirements": {
      "claim_to_beat_to_visual_traceability": true
    },
    "acceptance": {
      "plan": "Every factual beat is source-bound and every visual beat has a purpose and evidence reference."
    },
    "priority": 95
  },
  {
    "task_id": "platform-packaging",
    "title": "Write seven platform-native copies with distinct angle, mechanism and speaker",
    "kind": "platform_copywriting",
    "executor": "agent",
    "depends_on": [
