    ],
    "inputs": [
      "editorial-reading",
      "fact-map"
    ],
    "outputs": [
      "platform-copies"
    ],
    "requirements": {
      "platforms": [
        "X",
        "TikTok",
        "YouTube",
        "Xiaohongshu",
        "WeChat Channels",
        "Bilibili",
        "Douyin"
      ],
      "no_synonym_variants": true,
      "spoken_naturalness_required": true
    },
    "acceptance": {
      "copies": "Each platform copy uses native length, context, humor and audience behavior; no forced keywords or promotional tone."
    },
    "priority": 90
  },
  {
    "task_id": "master-timeline",
    "title": "Build the versioned audiovisual timeline and source/fiction boundary",
    "kind": "timeline_design",
    "executor": "agent",
    "depends_on": [
      "editorial-plan",
      "media-inspection"
    ],
    "inputs": [
      "editorial-plan",
      "visual-evidence-map",
      "source-video"
    ],
    "outputs": [
      "master-timeline"
    ],
    "requirements": {
      "source_digest_bound": true,
      "beat_to_shot_timing": true,
      "fiction_disclosure_preserved": true
    },
    "acceptance": {
      "timeline": "Every timeline segment references source media timestamps or a clearly marked proposed production asset."
    },
    "priority": 90
  },
  {
    "task_id": "human-cold-read",
    "title": "Obtain an independent human cold read of the actual editorial and platform package",
    "kind": "independent_editorial_review",
    "executor": "human",
    "depends_on": [
      "editorial-plan",
      "platform-packaging",
      "media-inspection"
    ],
    "inputs": [
      "editorial-reading",
      "editorial-plan",
      "platform-copies",
      "fact-map",
      "visual-evidence-map"
    ],
    "outputs": [
      "human-cold-read"
    ],
    "requirements": {
      "blind_review": true,
      "reviewer_not_author": true,
      "actual_artifacts_inspected": true
    },
    "acceptance": {
      "review": "The reviewer records comprehension, factual confusion, naturalness and platform fit against exact digests."
    },
    "priority": 100
  },
  {
