      "editorial-reading"
    ],
    "outputs": [
      "platform-format-review",
      "synthetic-upload-disclosure"
    ],
    "requirements": {
      "check_each_platform": true,
      "disclosure_state_checked_at_upload": true,
      "no_auto_publish": true
    },
    "acceptance": {
      "platform": "Every platform has a current format/disclosure receipt; uncertain requirements remain blockers."
    },
    "priority": 100
  },
  {
    "task_id": "red-team-review",
    "title": "Record at least three evidence-backed reasons not to release this package",
    "kind": "red_team_review",
    "executor": "human",
    "depends_on": [
      "editorial-plan",
      "master-timeline",
      "platform-packaging",
      "rights-and-identity"
    ],
    "inputs": [
      "editorial-plan",
      "master-timeline",
      "platform-copies",
      "rights-status",
      "fact-map"
    ],
    "outputs": [
      "red-team-review"
    ],
    "requirements": {
      "minimum_findings": 3,
      "evidence_per_finding": true,
      "disposition_per_finding": true
    },
