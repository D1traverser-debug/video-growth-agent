      "shot-contract",
      "graphic-spec",
      "font-asset",
      "rights-clearance"
    ],
    "outputs": [
      "graphic-candidate",
      "graphic-render-receipt"
    ],
    "requirements": {
      "domain_adapter": {
        "name": "programmatic_graphic_render",
        "editorial_plan_input": "editorial-plan",
        "shot_contract_input": "shot-contract",
        "graphic_spec_input": "graphic-spec",
        "font_input": "font-asset",
        "rights_evidence_input": "rights-clearance",
        "video_output": "graphic-candidate",
        "receipt_output": "graphic-render-receipt"
      }
    },
    "acceptance": {
      "candidate": "Register a non-empty MP4 and exact render receipt; candidate_only=true, promotion_authorized=false, release_authorized=false."
    },
    "priority": 100
  },
  {
    "task_id": "technical-qa",
    "title": "Run canonical digest-bound FFmpeg/FFprobe QA on the rendered candidate",
    "kind": "technical_measurement",
    "executor": "tool",
    "depends_on": [
      "render-programmatic-graphic"
    ],
    "inputs": [
      "graphic-candidate"
    ],
    "outputs": [
      "technical-qa-receipt"
    ],
    "requirements": {
      "tools": [
        "ffmpeg",
        "ffprobe"
      ],
      "resolution": "640x640",
      "frame_rate": 24,
      "duration_min_seconds": 1.9,
      "duration_max_seconds": 2.1,
      "audio_required": false
    },
    "acceptance": {
      "qa": "PASS video stream, stream timing, full decode, black frames and true-peak policy; receipt must bind the exact graphic-candidate artifact ID and digest."
    },
    "priority": 100
  }
