    "requirements": {
      "schema": "video_growth_agent.programmatic_graphics.GraphicSpec",
      "kind": "TITLE_CARD",
      "duration_seconds": 2,
      "width": 640,
      "height": 640,
      "fps": 24
    },
    "acceptance": {
      "spec": "Output valid GraphicSpec JSON with a short title and truthful subtitle/attribution."
    },
    "priority": 90
  },
  {
    "task_id": "render-programmatic-graphic",
    "title": "Render a candidate-only title-card MP4 through the local deterministic renderer",
