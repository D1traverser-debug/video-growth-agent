    "executor": "agent",
    "depends_on": [],
    "inputs": [],
    "outputs": [
      "editorial-plan"
    ],
    "requirements": {
      "schema": "video_growth_agent.editorial_planning.EditorialPlan",
      "episode_id": "E001",
      "series_id": "standalone-adapter-demo",
      "one_beat_one_shot": true
    },
    "acceptance": {
      "plan": "Output a complete JSON EditorialPlan with one beat B1 and one shot S1; the shot must be SYNTHETIC and allow PROGRAMMATIC_GRAPHICS."
    },
    "priority": 100
  },
  {
    "task_id": "validate-editorial-plan",
    "title": "Validate claim/beat/shot traceability and beat DAG",
    "kind": "domain_adapter",
    "executor": "tool",
    "depends_on": [
      "author-editorial-plan"
    ],
    "inputs": [
      "editorial-plan"
    ],
    "outputs": [
      "editorial-plan-validation"
    ],
    "requirements": {
      "domain_adapter": {
        "name": "editorial_plan_validate",
        "editorial_plan_input": "editorial-plan",
        "output_name": "editorial-plan-validation"
      }
    },
    "acceptance": {
      "validation": "The adapter must validate the exact JSON and emit a durable plan reference and object counts."
    },
    "priority": 100
  },
  {
    "task_id": "materialize-shot-contract",
    "title": "Materialize the shot execution contract from the validated EditorialPlan",
    "kind": "domain_adapter",
    "executor": "tool",
    "depends_on": [
