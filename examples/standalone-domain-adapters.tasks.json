        "editorial_plan_input": "editorial-plan",
        "shot_id": "S1",
        "sequence_id": "sequence-01",
        "required_capabilities": [
          "ffmpeg.drawtext"
        ],
        "quality_targets": {
          "readability": 4
        },
        "disclosure_required": true,
        "output_name": "shot-contract"
      }
    },
    "acceptance": {
      "contract": "ShotContract must bind the exact EditorialPlan ref, beat, source claims, truth mode, risk and permitted production mode."
    },
    "priority": 100
  },
  {
    "task_id": "author-graphic-spec",
    "title": "Author a concise title-card GraphicSpec",
    "kind": "graphic_spec_authoring",
    "executor": "agent",
    "depends_on": [
      "validate-editorial-plan"
    ],
    "inputs": [
